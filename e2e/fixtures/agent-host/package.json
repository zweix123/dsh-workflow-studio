{
  "name": "@dsh-workflow/agent-host-fixture",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./server.js",
    "./client": "./client.js",
    "./templates/probe/workflow.yaml": "./templates/probe/workflow.yaml",
    "./templates/*/workflow.yaml": "./templates/*/workflow.yaml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workflow-node",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.1",
    "dsh-workflow-node": "0.1.0",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.1"
  }
}
