{
  "name": "@dsh-workflow/node-session-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/dsh-workflow-node-session-agent/src/server.d.ts",
      "default": "./lib/server.js"
    },
    "./server": "./lib/server.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1"
  },
  "main": "lib/server.js",
  "types": "lib/types/dsh-workflow-node-session-agent/src/server.d.ts",
  "dependencies": {
    "dsh-workflow-node": "0.1.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-workflow-node",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "dsh-workflow-studio"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1"
  }
}
