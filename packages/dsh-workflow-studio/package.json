{
  "name": "dsh-workflow-studio",
  "version": "0.1.0",
  "description": "Workflow Studio plugin for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.dag-engine.json",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.1",
    "@xyflow/react": "^12.11.6",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "private": true
}
